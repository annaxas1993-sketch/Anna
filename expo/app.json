{
  "expo": {
    "name": "TAXI LIDER",
    "slug": "taxi-lider",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "am.axas.driver.expo",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "label": "TAXI LIDER",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#081321"
      },
      "versionCode": 2
    },
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TAXI LIDER-ը օգտագործում է տեղադրությունը՝ վարորդի դիրքը քարտեզում ցույց տալու համար։"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
