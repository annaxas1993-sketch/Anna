{
  "expo": {
    "name": "TAXI LIDER",
    "slug": "taxi-lider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "am.axas.driver.expo",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "label": "TAXI LIDER"
    },
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TAXI LIDER-ը օգտագործում է տեղադրությունը՝ վարորդի դիրքը քարտեզում ցույց տալու համար։"
        }
      ]
    ]
  }
}
